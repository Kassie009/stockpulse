# STOCKPULSE - Backend
# Copia este archivo a ".env" y pega tus valores reales.
# NUNCA subas el .env real a Git.

# ── Servidor ─────────────────────────────
PORT=3000
NODE_ENV=development

# ── Finnhub (informacion bursatil) ───────
FINNHUB_API_KEY=pegar_aqui

# ── Supabase (base de datos y auth) ──────
SUPABASE_URL=https://hjdwtktlmvpdujnpcewj.supabase.co
SUPABASE_PUBLISHABLE_KEY=pegar_aqui        # reemplaza al "anon key" publico
SUPABASE_SECRET_KEY=pegar_aqui             # reemplaza a "service_role". SOLO backend
SUPABASE_DB_PASSWORD=pegar_aqui

# ── Stripe (modo TEST) ───────────────────
STRIPE_SECRET_KEY=pegar_sk_test_aqui
STRIPE_PUBLISHABLE_KEY=pegar_pk_test_aqui  # esta es la unica que podra ir en la app Android
# STRIPE_WEBHOOK_SECRET=whsec_...          # se genera en FASE 8 con Stripe CLI

# ── Firebase (notificaciones FCM) ────────
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
